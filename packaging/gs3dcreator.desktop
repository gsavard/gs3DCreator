Icon=gs3dcreator
Terminal=false
Categories=Graphics;3DGraphics;Engineering;
Keywords=3D;STL;3MF;OBJ;impression;découpe;print;split;figurine;
StartupNotify=false
StartupWMClass=gs3dcreator
Actions=arreter;

[Desktop Action arreter]
